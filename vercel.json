{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "frontend/admin",
      "framework": "nextjs"
    },
    "web": {
      "root": "frontend/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
