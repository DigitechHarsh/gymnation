# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL via Prisma / Supabase / Neon / Render)
DATABASE_URL="postgresql://user:password@host:5432/gymnation_db?schema=public"

# Authentication Secrets (Generate secure random 32+ char strings)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_min_32_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_characters_long"

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Razorpay (Payments)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Shiprocket (Shipping & Logistics)
SHIPROCKET_EMAIL="your_email@gymnation.in"
SHIPROCKET_PASSWORD="your_password"
SHIPROCKET_WEBHOOK_TOKEN="your_webhook_token"

# SMTP / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@gymnation.in"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="GymNation The Fitness Hub <info@gymnation.in>"

# CORS Allowed Origins
FRONTEND_URL="https://gymnation.vercel.app"
ADMIN_URL="https://gymnation-admin.vercel.app"
